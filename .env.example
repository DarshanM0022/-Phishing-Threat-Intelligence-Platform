# PhishGuard AI - Environment Configuration Example

# Application Settings
ENVIRONMENT=development
APP_NAME="PhishGuard AI"
API_V1_STR="/api/v1"
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL or SQLite for local dev)
DATABASE_URL=sqlite:///./phishguard.db
# For PostgreSQL in production/docker:
# DATABASE_URL=postgresql://phishguard_user:phishguard_pass@localhost:5432/phishguard_db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Threat Intelligence API Keys (Optional - Fallbacks to mock providers when not set)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
WHOISXML_API_KEY=

# Machine Learning & Explainability Settings
MODEL_ARTIFACT_PATH=ml/models/random_forest_v1.joblib
ENABLE_SHAP_EXPLANATIONS=true
CACHE_TTL_SECONDS=3600

# LLM Explanation Layer (Optional - for analyst synthesis)
GEMINI_API_KEY=
USE_LOCAL_SYNTHESIS=true
